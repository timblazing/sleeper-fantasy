{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleeper-fantasy",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers Paid. The slowest measured render is ~1.5 s of CPU (cold standings); this caps a runaway
  // request well below the 30 s default.
  "limits": { "cpu_ms": 5000 },
  "workers_dev": true,
  // Cloudflare owns the DNS record and certificate for a custom domain.
  "routes": [{ "pattern": "sleeper.blasingame.dev", "custom_domain": true }],
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sleeper-fantasy" }],
  "r2_buckets": [
    // OpenNext's incremental cache (prefix `incremental-cache/`).
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sleeper-fantasy-cache" },
    // Player catalog and projection snapshots written by .github/workflows/sleeper-snapshots.yml.
    { "binding": "SNAPSHOTS", "bucket_name": "sleeper-fantasy-cache" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } }
}
