{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleeper-fantasy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Self-reference used by OpenNext's cache revalidation; must match "name".
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sleeper-fantasy" }],
  // Create once before the first deploy: npx wrangler r2 bucket create sleeper-fantasy-opennext-cache
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sleeper-fantasy-opennext-cache" }],
  "observability": { "enabled": true }
}
