{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview only: no routes or custom domains. Production stays on the Hostinger tunnel until the
  // cutover steps in docs/cloudflare-migration.md are run.
  "name": "sleeper-fantasy",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sleeper-fantasy" }],
  "r2_buckets": [
    // OpenNext's incremental cache (prefix `incremental-cache/`).
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sleeper-fantasy-cache" },
    // Player catalog and projection snapshots written by .github/workflows/sleeper-snapshots.yml.
    { "binding": "SNAPSHOTS", "bucket_name": "sleeper-fantasy-cache" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } }
}
